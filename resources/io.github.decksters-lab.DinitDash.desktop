[Desktop Entry]
Name=Dinit Dash
Comment=Displays information and allows you to manage system and user services
Comment[cs]=Zobrazuje informace a umožňuje spravovat systémové a uživatelské služby
Type=Application
Icon=io.github.decksters-lab.DinitDash
Exec=dinit-dash %F
Terminal=false
StartupNotify=true
Categories=System;Monitor;X-COSMIC;
Keywords=dinit;services;dinitctl;COSMIC;
Keywords[cs]=dinit;služby;dinitctl;COSMIC;
MimeType=
